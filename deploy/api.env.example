# Copy to /etc/dushevye/api.env on the server (chmod 600).
# Do not commit the filled file. api.env is gitignored.
DUSHEVYE_SESSION_SECRET=
DUSHEVYE_DB=/var/www/dushevye/data/app.db
DUSHEVYE_CATALOG_DB=/var/www/dushevye/data/catalog.db
# 0 while the site is HTTP-by-IP. Set to 1 only after HTTPS, or the browser will drop the session cookie.
DUSHEVYE_COOKIE_SECURE=0
